{
    "sources": {
        "status_url": "https://limbus-api.voidfissure.de/api/status",
        "raw_url_template": "https://downloadcommon.limbuscompanycdn.org/{token}/Assets/LocalizePatch/localize_{lang}.zip",
        "raw_languages": [
            "jp",
            "kr",
            "en"
        ],
        "cooked_repository": "LocalizeLimbusCompany/LocalizeLimbusCompany"
    },
    "network": {
        "connect_timeout": 15,
        "read_timeout": 180,
        "retries": 3,
        "github_token_env": "LCTA_FETCHER"
    },
    "translation": {
        "translator_name": "LLM通用翻译服务",
        "api_key_env": "DEEPSEEK",
        "api": {
            "base_url": "https://api.deepseek.com/v1",
            "model_name": "deepseek-v4-pro",
            "temperature": 1.0,
            "max_tokens": 8000,
            "top_p": 1.0,
            "frequency_penalty": 0.0,
            "presence_penalty": 0.0
        },
        "from_lang": "EN",
        "proper_path": "",
        "max_workers": 4,
        "translation_mode": "multi_stage",
        "disambiguation_mode": "hybrid",
        "min_confidence": "medium",
        "prompt_format": "xml_json"
    },
    "features": {
        "enabled": true,
        "deduplicate": true,
        "enable_proper": true,
        "auto_fetch_proper": true,
        "enable_role": true,
        "enable_skill": true,
        "enable_concurrent": true,
        "enable_self_check": false,
        "enable_rule_validation": true,
        "enable_thinking": false,
        "fallback": true,
        "debug_mode": false,
        "dump": false
    },
    "publishing": {
        "zip": true,
        "seven_zip": true,
        "output_dir": "LLc-CN-LCTA",
        "asset_prefix": "LLc-CN-LCTA",
        "upload_diagnostics": true
    }
}
